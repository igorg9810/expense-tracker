// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_PATH")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expenses    Expense[]
  resetCodes  ResetCode[]
  refreshTokens RefreshToken[]
}

model Expense {
  id          Int      @id @default(autoincrement())
  amount      Float
  name        String
  currency    String
  category    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  displayOrder Int     @default(0)
  
  // Performance indexes
  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
  @@index([userId, displayOrder])
  @@index([date])
  @@index([category])
}

model ResetCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  userId      Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([code])
  @@index([userId])
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}
