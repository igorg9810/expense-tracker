# =============================================================================
# ExpenseTracker Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development  # Options: development, production, test

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite database path
# Development: ./data/expense-tracker.db
# Docker: file:/app/data/expense-tracker.db
DB_PATH=./data/expense-tracker.db

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Set to 'false' to disable logging entirely (useful for testing)
LOG_ENABLED=true

# Available log levels: error, warn, info, http, debug
# - error: Only error messages
# - warn: Warnings and errors
# - info: Informational messages, warnings, and errors (default for production)
# - http: HTTP request logs + above
# - debug: Detailed debug information + all above (recommended for development)
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# CORS Origins - Legacy variable (kept for backwards compatibility)
CORS_ORIGIN=*

# CORS Allowed Origins - Used in production mode
# Comma-separated list of allowed origins
# Example: http://localhost:8080,http://localhost:5173,https://myapp.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Maximum requests per window

# -----------------------------------------------------------------------------
# JWT Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Generate secure secrets using one of these methods:
# - Linux/Mac: openssl rand -base64 32
# - Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-minimum-32-characters

# Token expiration times
JWT_EXPIRES_IN=15m           # Access token: 15 minutes
JWT_REFRESH_EXPIRES_IN=7d    # Refresh token: 7 days

# -----------------------------------------------------------------------------
# Email Configuration (REQUIRED for password reset functionality)
# -----------------------------------------------------------------------------
# SMTP server configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false           # true for port 465, false for other ports

# Gmail App Password Setup:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Other (Custom name)"
# 4. Generate and copy the 16-character password
# 5. Use this password in EMAIL_PASSWORD

EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password  # Gmail App Password (16 characters)
EMAIL_FROM=noreply@expensetracker.com   # Sender email address

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Pagination defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# -----------------------------------------------------------------------------
# Development / Testing Configuration
# -----------------------------------------------------------------------------
# Uncomment and set these for local testing

# Test user credentials (optional, for development)
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=TestPassword123

# Debug mode (optional)
# DEBUG=true

# -----------------------------------------------------------------------------
# Production Notes
# -----------------------------------------------------------------------------
# For production deployment:
# 1. Set NODE_ENV=production
# 2. Generate strong JWT secrets (min 32 characters)
# 3. Configure specific ALLOWED_ORIGINS (remove wildcards)
# 4. Set up proper email credentials
# 5. Use absolute paths for DB_PATH if needed
# 6. Consider using secrets management (AWS Secrets Manager, HashiCorp Vault, etc.)
# 7. Enable HTTPS and set secure cookies
# 8. Review rate limiting settings based on your traffic
# -----------------------------------------------------------------------------