# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_PATH=./data/expense-tracker.db

# Logging Configuration
# Set to 'false' to disable logging entirely (useful for testing)
LOG_ENABLED=true
# Available log levels: error, warn, info, http, debug
# - error: Only error messages
# - warn: Warnings and errors
# - info: Informational messages, warnings, and errors (default for production)
# - http: HTTP request logs + above
# - debug: Detailed debug information + all above (recommended for development)
LOG_LEVEL=info

# Security
CORS_ORIGIN=* # Use comma-separated list for multiple origins
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# API Configuration
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100